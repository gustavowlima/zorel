{
  "name": "zorel",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "test": "bun test apps/server apps/web apps/desktop/src packages",
    "build": "bun run --cwd apps/web build",
    "start": "bun run build && bun apps/server/src/main.ts",
    "desktop": "bun run --cwd apps/desktop start",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run --cwd apps/desktop build",
    "typecheck": "tsc -p apps/server && tsc -p apps/web",
    "lint": "biome lint",
    "check:ui": "bun scripts/check-ui.ts",
    "check:i18n": "bun scripts/check-i18n.ts",
    "schema": "bun packages/contracts/scripts/export-schema.ts",
    "tokens": "bun scripts/export-tokens.ts",
    "i18n:native": "bun scripts/export-i18n.ts",
    "native": "cargo run -p zorel-native",
    "native:check": "cargo fmt --check && cargo clippy -p zorel-native --locked -- --deny warnings && typos apps/native && cargo machete apps/native && cargo deny --manifest-path apps/native/Cargo.toml check"
  },
  "devDependencies": {
    "@babel/parser": "7.29.12",
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
