<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's exceptions a Developer ID build needs (notarization requires the runtime). The app and every
     program inside it (zorel-server, the agents' Chromium) get these. -->
<plist version="1.0">
<dict>
  <!-- V8 (Electron, Chromium) and Bun's JavaScriptCore (zorel-server) compile JavaScript at run time. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Electron's frameworks and the bundled Chromium are signed by their makers, not by this team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
