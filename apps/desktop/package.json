{
  "name": "@zero/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun run --cwd ../web build && rm -rf web && cp -R ../web/dist web",
    "icons": "sh scripts/icons.sh",
    "build": "electrobun build --env=stable",
    "start": "bun run prebuild && electrobun dev"
  },
  "dependencies": {
    "electrobun": "2.0.5"
  }
}
